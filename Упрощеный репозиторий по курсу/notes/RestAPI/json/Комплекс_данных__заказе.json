{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Комплекс данных о заказе",
    "type": "object",
    "properties": {
        "orderId": {
            "type": "string"
        },
        "userId": {
            "type": "string"
        },
        "creationDate": {
            "type": "string",
            "format": "date-time"
        },
        "lastUpdate": {
            "type": "string",
            "format": "date-time"
        },
        "products": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "productId": {           
                        "type": "string"
                    },
                    "productName": {
                        "type": "string"
                    },
                    "quantity": {
                        "type": "number"
                    }
                },
                "required": [               
                    "productId",
                    "productName",
                    "quantity"
                ]
            }
        },
        "shippingAddress": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "street": {
                    "type": "string"
                },
                "postIndex": {
                    "type": "integer"
                }
            },
            "required": [                  
                "city",
                "street",
                "postIndex"
            ]
        }
    },
    "required": [                           
        "orderId",
        "userId",
        "creationDate",
        "lastUpdate",
        "products",
        "shippingAddress"
    ]
}